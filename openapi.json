{
    "openapi": "3.0.0",
    "info": {
        "title": "Expense Manager API",
        "version": "1.0.0",
        "description": "API for storing and viewing personal expenses. See Appendix for changes from the original brief specification."
    },
    "paths": {
        "/api/expenses": {
            "get": {
                "summary": "List all expenses",
                "responses": {
                    "200": {
                        "description": "A list of expenses",
                        "content": {
                            "application/json": {
                                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Expense" } }
                            }
                        }
                    }
                }
            },
            "post": {
                "summary": "Create a new expense",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": { "schema": { "$ref": "#/components/schemas/ExpenseInput" } }
                    }
                },
                "responses": {
                    "201": { "description": "Expense created" },
                    "422": { "description": "Validation error" }
                }
            }
        },
        "/api/expenses/{id}": {
            "get": {
                "summary": "Get a single expense by ID",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
                ],
                "responses": {
                    "200": { "description": "The expense" },
                    "404": { "description": "Not found" }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Expense": {
                "type": "object",
                "properties": {
                    "id": { "type": "integer" },
                    "date": { "type": "string", "format": "date" },
                    "cost": { "type": "number", "format": "float", "description": "CHANGED: renamed from cost_gbp to cost — see Appendix." },
                    "description": { "type": "string" },
                    "expense_type": { "type": "string", "enum": ["travel", "food", "other"] }
                }
            },
            "ExpenseInput": {
                "type": "object",
                "required": ["date", "cost", "description", "expense_type"],
                "properties": {
                    "date": { "type": "string", "format": "date" },
                    "cost": { "type": "number", "format": "float" },
                    "description": { "type": "string" },
                    "expense_type": { "type": "string", "enum": ["travel", "food", "other"] }
                }
            }
        }
    },
    "x-appendix-of-changes": [
        "Renamed the monetary field from 'cost_gbp' to a currency-neutral 'cost' because the brief's Basic Requirements text and OpenAPI description conflicted (rupees vs GBP). Documented and justified this decision in the submission report.",
        "Added GET /api/expenses/{id} as a distinct endpoint for viewing individual expense detail, per the Basic Requirements.",
        "Constrained expense_type to an enum (travel, food, other) matching the brief exactly."
    ]
}
